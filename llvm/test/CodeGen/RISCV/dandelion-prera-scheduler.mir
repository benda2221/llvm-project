# RUN: llc -mtriple=riscv32 -mcpu=dandelion -run-pass=machine-scheduler \
# RUN:   -riscv-dandelion-prera-scheduler=generic \
# RUN:   -debug-only=machine-scheduler -o /dev/null %s 2>&1 \
# RUN:   | FileCheck %s --check-prefix=GENERIC
# RUN: llc -mtriple=riscv32 -mcpu=dandelion -run-pass=machine-scheduler \
# RUN:   -riscv-dandelion-prera-scheduler=vliw \
# RUN:   -debug-only=machine-scheduler -o /dev/null %s 2>&1 \
# RUN:   | FileCheck %s --check-prefix=VLIW
# REQUIRES: asserts

# GENERIC: ScheduleDAGMILive::schedule starting
# GENERIC-NOT: MI Converging Scheduling VLIW
# VLIW: MI Converging Scheduling VLIW

---
name: prera_scheduler_selection
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10, $x11, $x12
    %0:gpr = COPY $x10
    %1:gpr = COPY $x11
    %2:gpr = COPY $x12
    %3:gpr = ADD %0, %1
    %4:gpr = MUL %1, %2
    %5:gpr = XOR %3, %4
    $x10 = COPY %5
    PseudoRET implicit $x10
...
