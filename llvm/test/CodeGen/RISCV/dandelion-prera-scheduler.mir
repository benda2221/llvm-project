# RUN: llc -mtriple=riscv32 -mcpu=dandelion -run-pass=machine-scheduler \
# RUN:   -riscv-dandelion-prera-scheduler=generic \
# RUN:   -debug-only=machine-scheduler -o /dev/null %s 2>&1 \
# RUN:   | FileCheck %s --check-prefix=GENERIC
# RUN: llc -mtriple=riscv32 -mcpu=dandelion -run-pass=machine-scheduler \
# RUN:   -riscv-dandelion-prera-scheduler=vliw \
# RUN:   -debug-only=machine-scheduler -o /dev/null %s 2>&1 \
# RUN:   | FileCheck %s --check-prefix=VLIW
# RUN: llc -mtriple=riscv32 -mcpu=dandelion -run-pass=machine-scheduler \
# RUN:   -riscv-dandelion-prera-scheduler=dandelion \
# RUN:   -misched-prera-direction=topdown \
# RUN:   -debug-only=machine-scheduler -o /dev/null %s 2>&1 \
# RUN:   | FileCheck %s --check-prefix=DANDELION
# REQUIRES: asserts

# GENERIC: ScheduleDAGMILive::schedule starting
# GENERIC-NOT: MI Converging Scheduling VLIW
# VLIW: MI Converging Scheduling VLIW
# DANDELION: MI Converging Scheduling VLIW
# DANDELION: Dandelion VLIW candidate
# DANDELION: Dandelion VLIW candidate opcode={{[0-9]+}} packet-size={{[1-9][0-9]*}} legal=1
# DANDELION: Dandelion VLIW cost bonus=
# DANDELION: Dandelion VLIW packet boundary opcode={{[0-9]+}} direction=top

---
name: prera_scheduler_selection
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10, $x11, $x12
    %0:gpr = COPY $x10
    %1:gpr = COPY $x11
    %2:gpr = COPY $x12
    %3:gpr = ADD %0, %1
    %4:gpr = MUL %1, %2
    %5:gpr = XOR %3, %4
    $x10 = COPY %5
    PseudoRET implicit $x10
...
---
name: prera_independent_packet
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10, $x11
    dead %0:gpr = ADD $x10, $x11
    dead %1:gpr = SUB $x10, $x11
    dead %2:gpr = XOR $x10, $x11
    dead %3:gpr = CSRRS 768, $x10
    PseudoRET
...
